# Copy to .env and fill in. NWS/SPC ask for a real contact in the User-Agent.
USER_AGENT=weather-dashboard (your-email@example.com)

# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DEFAULT_LAT=42.7325
DEFAULT_LON=-84.5555
DEFAULT_LABEL=Lansing, MI
