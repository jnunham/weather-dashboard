# Base URL of the backend API. Leave this UNSET (the default) — the app
# then talks to the backend on the same host the page was loaded from
# (port 8000), which is what makes it work correctly both from this machine
# and from other devices on your LAN. Only set this for an unusual setup,
# e.g. the backend running on a different host or port than the frontend.
#VITE_API_BASE_URL=http://localhost:8000
